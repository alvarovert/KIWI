{
  "name": "consol",
  "version": "1.0.0",
  "description": "Herramienta de escritorio ligera para unificar y filtrar múltiples archivos Excel.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:python": "pyinstaller --noconfirm --onedir --console --distpath ./backend/dist --workpath ./backend/build backend/consol_engine.py"
  },
  "author": "Alvaro Menacho",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.alvaromenacho.kiwi",
    "productName": "KIWI",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "extraResources": [
      {
        "from": "backend/dist/consol_engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}